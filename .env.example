# =============================================================================
# Palace Karimi B2B Export — Environment Configuration
# Copy this file to .env and fill in production values.
# =============================================================================
# Django Core
DEBUG=False
SECRET_KEY=change-me-to-a-long-random-string-at-least-50-chars
ALLOWED_HOSTS=example.com,www.example.com
CSRF_TRUSTED_ORIGINS=https://example.com,https://www.example.com

# Database (PostgreSQL)
DB_NAME=palace_db
DB_USER=palace_user
DB_PASSWORD=change-me-to-a-strong-password
DB_HOST=db
DB_PORT=5432

# Backup (used by backup.sh — container name)
DB_CONTAINER_NAME=palace_postgres

# Logging (optional — defaults to INFO)
# DJANGO_LOG_LEVEL=INFO
