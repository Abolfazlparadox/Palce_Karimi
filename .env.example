# Palace Karimi — Environment Configuration Example
# Copy this file to .env and fill in the values.
# NEVER commit .env to version control.

# ==============================================================================
# Django Core
# ==============================================================================
SECRET_KEY=your-very-long-random-secret-key-here
DEBUG=False
ALLOWED_HOSTS=yourdomain.com,www.yourdomain.com
CSRF_TRUSTED_ORIGINS=https://yourdomain.com,https://www.yourdomain.com

# ==============================================================================
# Database (PostgreSQL)
# ==============================================================================
DB_NAME=palace_db
DB_USER=postgres
DB_PASSWORD=your-strong-db-password
# Development: use 127.0.0.1 when PostgreSQL is in Docker and Django runs locally
# Production Docker: use "db" (the Docker service name)
DB_HOST=db
DB_PORT=5432

# ==============================================================================
# Backup (optional)
# ==============================================================================
DB_CONTAINER_NAME=palace_postgres
BACKUP_DIR=/var/backups/palace_karimi

# ==============================================================================
# Logging
# ==============================================================================
DJANGO_LOG_LEVEL=INFO
