msgid "Elegant and secure packaging maintaining freshness and aroma."
msgstr "Zarafet ve tazeliği koruyan şık ve güvenli ambalaj."

msgid "Lab Certified"
msgstr "Laboratuvar Sertifikalı"

msgid "Rigorous laboratory testing for color, flavor, and purity."
msgstr "Renk, lezzet ve saflık için titiz laboratuvar testleri."

msgid "Direct from Farms"
msgstr "Doğrudan Çiftliklerden"

msgid "Sourced directly from the best Iranian agricultural lands."
msgstr "Doğrudan en iyi İran tarım arazilerinden temin edilmiştir."

msgid "Wholesale Supply"
msgstr "Toptan Tedarik"

